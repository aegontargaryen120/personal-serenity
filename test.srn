func factorial(x) => (
    if (x < 0) => {
        println("Factorial is not defined for negative numbers.");
        exit(1);
    } else => {
        let result = 1;
        for (let i = 0; i < x + 1; i++) => {
            result = result * i;
        }
        return result;
    }
)

func main() => (
    println("Hello, world!");
)
